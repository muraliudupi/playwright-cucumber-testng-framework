<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Playwright-Cucumber-Suite" data-provider-thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.framework.listeners.FrameworkSuiteListener"/>
    </listeners>

    <test name="Cucumber-Regression-Test">
        <classes>
            <class name="com.framework.runners.WebTestNGRunner"/>
            <class name="com.framework.runners.MobileTestNGRunner"/>
        </classes>
    </test>
</suite>
